# Sanity Studio — Environment Variables
# Copy this file to .env and fill in your values.
# Get these from: https://www.sanity.io/manage → your project → Settings → API

# Your Sanity project ID (visible in sanity.io/manage)
SANITY_PROJECT_ID=YOUR_PROJECT_ID

# Dataset name — default is "production"
SANITY_DATASET=production

# Optional: used by sanity CLI for authenticated operations
# Create a token at: sanity.io/manage → API → Tokens → Add API Token
# Role: Editor (for content management) or Viewer (read-only)
SANITY_API_TOKEN=
